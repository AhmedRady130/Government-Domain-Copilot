# Required for Docker Compose. Use a unique local-only value; never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password

# Optional local defaults.
POSTGRES_DB=government_domain_copilot
POSTGRES_USER=government_domain_copilot
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Required only to call endpoints that generate embeddings or chat completions.
# Health, readiness, migrations, and the baseline identity initialization do not use it.
GEMINI_API_KEY=
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_PRIMARY_PROVIDER=Gemini
# Local Ollama is optional. Select it with LLM_PRIMARY_PROVIDER=Ollama and ensure
# an Ollama server and the configured model are available.
LLM_OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_PRIMARY_PROVIDER=Gemini
EMBEDDING_PRIMARY_MODEL=gemini-embedding-2

# Optional embedding fallback. Compose does not run Ollama; point this at a separately
# running instance if it is needed (host.docker.internal is the Docker Desktop default).
EMBEDDING_FALLBACK_PROVIDER=Ollama
EMBEDDING_FALLBACK_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://host.docker.internal:11434
