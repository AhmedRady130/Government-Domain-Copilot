{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "government-domain-copilot-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "gdc",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": { "outputPath": "dist/government-domain-copilot-web", "index": "src/index.html", "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "assets": [], "styles": ["src/styles.css"] },
          "configurations": {
            "production": { "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }], "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false, "fileReplacements": [{ "replace": "src/environments/environment.ts", "with": "src/environments/environment.development.ts" }] }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": { "production": { "buildTarget": "government-domain-copilot-web:build:production" }, "development": { "buildTarget": "government-domain-copilot-web:build:development" } },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": { "polyfills": ["zone.js", "zone.js/testing"], "tsConfig": "tsconfig.spec.json", "assets": [], "styles": ["src/styles.css"] }
        }
      }
    }
  }
}
